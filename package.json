{
  "name": "codora",
  "displayName": "Codora",
  "description": "Know the code you ship. Codora asks one short question about code you just changed, so code an AI wrote never becomes code nobody understands.",
  "version": "0.2.0",
  "publisher": "solomon-mh",
  "license": "MIT",
  "icon": "media/marketplace-icon.png",
  "galleryBanner": {
    "color": "#121412",
    "theme": "dark"
  },
  "homepage": "https://solomon-mh.github.io/codora/",
  "repository": {
    "type": "git",
    "url": "https://github.com/solomon-mh/codora.git"
  },
  "bugs": {
    "url": "https://github.com/solomon-mh/codora/issues"
  },
  "keywords": [
    "ai",
    "comprehension",
    "code review",
    "learning",
    "quiz",
    "claude",
    "copilot",
    "understanding",
    "comprehension debt"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Education",
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codora",
          "title": "Codora",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codora": [
        {
          "id": "codora.sidebar",
          "name": "Codora",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codora.openDashboard",
        "title": "Codora: Open Dashboard"
      },
      {
        "command": "codora.startChallenge",
        "title": "Codora: Start Challenge"
      },
      {
        "command": "codora.pauseChallenges",
        "title": "Codora: Pause Challenges"
      },
      {
        "command": "codora.resumeChallenges",
        "title": "Codora: Resume Challenges"
      },
      {
        "command": "codora.showAura",
        "title": "Codora: Show Aura"
      },
      {
        "command": "codora.showProgress",
        "title": "Codora: Show Progress"
      },
      {
        "command": "codora.startDeepChallenge",
        "title": "Codora: Start Deep Challenge"
      },
      {
        "command": "codora.resetProjectData",
        "title": "Codora: Reset Project Data"
      },
      {
        "command": "codora.configureAI",
        "title": "Codora: Configure AI Provider"
      },
      {
        "command": "codora.showOutput",
        "title": "Codora: Show Logs"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "test": "vitest run",
    "lint": "eslint src webview --ext .ts,.tsx",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@google/genai": "^2.22.0",
    "openai": "^7.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
